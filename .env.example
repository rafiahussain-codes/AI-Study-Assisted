# Environment configuration template for Student Score Predictor
# Copy this file to .env and configure your local settings.

# Flask environment settings
FLASK_ENV=development
FLASK_DEBUG=false
PORT=5000

# LLM API Configuration
# Option A: Google Gemini API (Keys typically start with AIza...)
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash

# Option B: Groq API (Keys typically start with gsk_...)
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=openai/gpt-oss-20b
